{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://13-235-145-68.sslip.io/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://13-235-145-68.sslip.io/auth/:path*" },
    { "source": "/crm/tasks/:id", "destination": "https://13-235-145-68.sslip.io/crm/tasks/:id" },
    { "source": "/helpdesk/tickets/:id", "destination": "https://13-235-145-68.sslip.io/helpdesk/tickets/:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
